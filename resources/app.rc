// VER_MAJOR, VER_MINOR and VER_PATCH come from Cargo.toml via build.rs.
#define STR2(x) #x
#define STR(x) STR2(x)
#define VER_STRING STR(VER_MAJOR) "." STR(VER_MINOR) "." STR(VER_PATCH)

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Fancy Window - tiling host for Windows"
      VALUE "ProductName", "Fancy Window"
      VALUE "FileVersion", VER_STRING
      VALUE "ProductVersion", VER_STRING
      VALUE "OriginalFilename", "FancyWindow.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
